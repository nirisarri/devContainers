# Copy to .env and adjust. Never commit the real .env.

# Consumed by the postgres image in compose.yaml; canonical source for the DB credentials below.
POSTGRES_USER=pg-user
POSTGRES_PASSWORD=s3cr3t.
POSTGRES_DB=development

# Application settings (pydantic-settings, PYSAMPLE_ prefix); derived via variable expansion.
PYSAMPLE_POSTGRES_HOST=db
PYSAMPLE_POSTGRES_PORT=5432
PYSAMPLE_POSTGRES_USER=${POSTGRES_USER}
PYSAMPLE_POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
PYSAMPLE_POSTGRES_DB=${POSTGRES_DB}
